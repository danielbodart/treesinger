#!/bin/sh
# The one place Treesinger's build is defined, so CI runs the same commands a
# developer does: ./run <version|check|test|build|release|image> [args].
set -eu

cd "$(dirname "$0")"

# The package the version is set in, at link time.
VERSION_VAR=github.com/danielbodart/treesinger/internal/broker.Version

die() {
  echo "Error: $*" >&2
  exit 1
}

# The version, derived from the repository rather than stored in it.
#
# Only the major is committed (in MAJOR, a file so that the flake reads the same
# one) - it is the one part that is a deliberate decision. Minor is the commit
# count, so it only ever rises and names exactly one commit. Patch is the CI run
# number (or a local timestamp), separating two builds of the same commit - a
# re-run or a manual build - and making a developer build sort after CI's and
# obviously not one.
version() {
  # Counted from HEAD, not from a branch name. On Actions the checkout is
  # detached, so `git rev-parse --abbrev-ref HEAD` answers "HEAD", and
  # GITHUB_REF_NAME on a pull request is "123/merge", which is not a rev at
  # all. HEAD is the commit being built in every one of those cases.
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    die "this is a shallow clone, so the commit count is wrong and so is the version. In Actions, checkout with \`fetch-depth: 0\`."
  fi
  echo "$(cat MAJOR).$(git rev-list --count HEAD).${GITHUB_RUN_NUMBER:-$(date -u +%Y%m%d%H%M%S)}"
}

check() {
  unformatted=$(gofmt -l .)
  [ -z "$unformatted" ] || die "not gofmt'd: $unformatted"
  go vet ./...
}

test() {
  go test -count=1 "$@" ./...
}

# Static, so the one binary runs on any distribution and in an empty image. The
# version reaches it as a link-time -X rather than a generated file, so nothing
# is written into the tree; without one it says "development", which is the
# truth about a `go run`.
compile() {
  CGO_ENABLED=0 GOOS=linux GOARCH="$2" \
    go build -trimpath -ldflags "-s -w -X $VERSION_VAR=$1" -o "$3" .
}

build() {
  outfile=${1:-dist/treesinger}
  v=$(version)
  compile "$v" "$(go env GOARCH)" "$outfile"
  echo "built $outfile $v"
}

# What a GitHub release carries: a binary per architecture, the plain systemd
# units that run it (the service and its two sockets), the sysusers file, and
# their checksums, all in one directory for CI to upload as they are. The
# names are what releases/latest/download links point at, so they stay put;
# x64 is Go's amd64.
release() {
  dir=${1:-dist/release}
  v=$(version)
  rm -rf "$dir"
  mkdir -p "$dir"
  compile "$v" amd64 "$dir/treesinger-linux-x64"
  compile "$v" arm64 "$dir/treesinger-linux-arm64"
  units="treesinger.service treesinger.socket treesinger-admin.socket treesinger.sysusers"
  for f in $units; do cp "contrib/systemd/$f" "$dir/"; done
  # shellcheck disable=SC2086 # $units is a list of plain names
  (cd "$dir" && sha256sum treesinger-linux-x64 treesinger-linux-arm64 $units > SHA256SUMS)
  echo "built $dir $v"
}

# The same image CI publishes, for both architectures, built locally.
image() {
  docker buildx build --platform linux/amd64,linux/arm64 --build-arg VERSION="$(version)" \
    --tag "${1:-ghcr.io/danielbodart/treesinger:dev}" .
}

command=${1:-build}
[ $# -gt 0 ] && shift
case $command in
  version|check|test|build|release|image) "$command" "$@" ;;
  *)
    echo "Error: '$command' is not a command. Try: version, check, test, build, release, image" >&2
    exit 2
    ;;
esac
