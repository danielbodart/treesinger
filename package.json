    "version": "bun run.ts version",
    "check": "bun run.ts check",
    "test": "bun run.ts test",
    "build": "bun run.ts build",
    "image": "bun run.ts image"
  },
  "dependencies": {
    "@bodar/yadic": "npm:@jsr/bodar__yadic"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
