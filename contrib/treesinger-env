#!/bin/sh
# treesinger-env [--socket PATH | --url URL] -- COMMAND [ARGS...]
#
# Mint a session from a Treesinger broker, then become COMMAND with it in the
# environment the Hytale server reads itself (HYTALE_SERVER_SESSION_TOKEN /
# HYTALE_SERVER_IDENTITY_TOKEN), so the tokens never touch argv. Any failure —
# no broker, not logged in, a bad answer — warns and runs COMMAND without
# them: an unauthenticated boot, recoverable, rather than no boot at all.
#
# For a systemd unit's ExecStart (an ExecStartPre cannot set ExecStart's
# environment), and the same POST a Hytale image makes to TREESINGER_URL.
# exec matters: COMMAND keeps this process's pid, stdin and notify socket.
#
# TREESINGER_BEARER_TOKEN, if set, is sent as the bearer token (through
# curl's stdin, not argv) and not passed on to COMMAND.
set -eu

usage() {
    echo "usage: treesinger-env [--socket PATH | --url URL] -- COMMAND [ARGS...]" >&2
    exit 64
}

socket=
url=
while [ $# -gt 0 ]; do
    case $1 in
        --socket) [ $# -ge 2 ] || usage; socket=$2; shift 2 ;;
        --url) [ $# -ge 2 ] || usage; url=$2; shift 2 ;;
        --) shift; break ;;
        *) usage ;;
    esac
done
[ $# -gt 0 ] || usage
[ -z "$socket" ] || [ -z "$url" ] || usage

# Any host will do over a socket; it only fills in the URL.
if [ -n "$socket" ]; then
    endpoint=http://treesinger/v1/session
    where=$socket
elif [ -n "$url" ]; then
    endpoint=${url%/}/v1/session
    where=$url
else
    usage
fi

bearer=${TREESINGER_BEARER_TOKEN:-}
unset TREESINGER_BEARER_TOKEN

if response=$(
    if [ -n "$bearer" ]; then printf 'Authorization: Bearer %s\n' "$bearer"; fi |
        curl -fsS -m 10 -X POST -H @- ${socket:+--unix-socket "$socket"} "$endpoint" 2>&1
); then
    session=$(printf '%s' "$response" | jq -r '.sessionToken // empty' 2>/dev/null || true)
    identity=$(printf '%s' "$response" | jq -r '.identityToken // empty' 2>/dev/null || true)
    if [ -n "$session" ] && [ -n "$identity" ]; then
        export HYTALE_SERVER_SESSION_TOKEN="$session"
        export HYTALE_SERVER_IDENTITY_TOKEN="$identity"
        echo "treesinger-env: authenticated via Treesinger ($where)" >&2
    else
        echo "treesinger-env: WARNING: Treesinger's answer carried no tokens; running unauthenticated" >&2
    fi
else
    echo "treesinger-env: WARNING: no session from Treesinger at $where (${response:-no answer}); running unauthenticated" >&2
fi

exec "$@"
